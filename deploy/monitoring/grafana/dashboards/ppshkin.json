{
  "uid": "ppshkin",
  "title": "ППшкин",
  "tags": ["ppshkin"],
  "timezone": "browser",
  "refresh": "30s",
  "schemaVersion": 39,
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "type": "row", "title": "Сервис", "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "stat", "title": "Сайт /ready",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "targets": [{ "refId": "A", "expr": "min(probe_success{job=\"blackbox\"})" }],
      "fieldConfig": { "defaults": {
        "mappings": [{ "type": "value", "options": { "0": { "text": "недоступен", "color": "red" }, "1": { "text": "работает", "color": "green" } } }],
        "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
      } },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat", "title": "Сертификат, дней",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "targets": [{ "refId": "A", "expr": "min(probe_ssl_earliest_cert_expiry{job=\"blackbox\"} - time()) / 86400" }],
      "fieldConfig": { "defaults": { "decimals": 0,
        "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "orange", "value": 14 }, { "color": "green", "value": 30 }] }
      } },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat", "title": "Запросов в секунду",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "targets": [{ "refId": "A", "expr": "sum(rate(http_request_duration_seconds_count{job=\"backend\"}[5m]))" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2 } },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat", "title": "Ошибки 5xx",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "targets": [{ "refId": "A", "expr": "(sum(rate(http_request_duration_seconds_count{job=\"backend\",status_code=~\"5..\"}[5m])) or vector(0)) / clamp_min(sum(rate(http_request_duration_seconds_count{job=\"backend\"}[5m])), 0.0001)" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 1,
        "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.01 }, { "color": "red", "value": 0.05 }] }
      } },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat", "title": "p95 ответа API",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"backend\",route!~\"/max/webhook|/api/v1/diary/meals/(photo|text)|/api/v1/venue/menu/imports.*\"}[5m])))" }],
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 2,
        "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 2 }] }
      } },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat", "title": "Активные алерты",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "targets": [{ "refId": "A", "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)" }],
      "fieldConfig": { "defaults": { "decimals": 0,
        "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
      } },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "row", "title": "Продукт", "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }
    },
    {
      "type": "stat", "title": "Пользователи",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 6 },
      "targets": [{ "refId": "A", "expr": "ppshkin_users" }],
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat", "title": "Записей в дневнике за сутки",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 6 },
      "targets": [{ "refId": "A", "expr": "ppshkin_meals_last_day" }],
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat", "title": "Горящие позиции сейчас",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 6 },
      "targets": [{ "refId": "A", "expr": "ppshkin_active_deals" }],
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat", "title": "Активные брони",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 6 },
      "targets": [{ "refId": "A", "expr": "ppshkin_bookings{status=\"active\"}" }],
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat", "title": "Погашено броней всего",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 6 },
      "targets": [{ "refId": "A", "expr": "ppshkin_bookings{status=\"redeemed\"}" }],
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat", "title": "Принятые предложения",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 6 },
      "targets": [{ "refId": "A", "expr": "ppshkin_offers{status=\"accepted\"} / clamp_min(sum(ppshkin_offers), 1)" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 1 } },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "timeseries", "title": "Запросы по маршрутам",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "targets": [{ "refId": "A", "expr": "topk(8, sum by (route) (rate(http_request_duration_seconds_count{job=\"backend\"}[5m])))", "legendFormat": "{{route}}" }],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "type": "timeseries", "title": "Задержка API без распознавания",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.5, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"backend\",route!~\"/max/webhook|/api/v1/diary/meals/(photo|text)|/api/v1/venue/menu/imports.*\"}[5m])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"backend\",route!~\"/max/webhook|/api/v1/diary/meals/(photo|text)|/api/v1/venue/menu/imports.*\"}[5m])))", "legendFormat": "p95" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "type": "timeseries", "title": "Ответы по кодам",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "targets": [{ "refId": "A", "expr": "sum by (status_code) (rate(http_request_duration_seconds_count{job=\"backend\"}[5m]))", "legendFormat": "{{status_code}}" }],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "type": "timeseries", "title": "Распознавание фото и меню",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_seconds_bucket{job=\"backend\",route=~\"/api/v1/diary/meals/(photo|text)|/api/v1/venue/menu/imports/(photo|text)\"}[15m])))", "legendFormat": "p95 {{route}}" }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "type": "timeseries", "title": "Брони по статусам",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 26 },
      "targets": [{ "refId": "A", "expr": "ppshkin_bookings", "legendFormat": "{{status}}" }]
    },
    {
      "type": "timeseries", "title": "Webhook MAX",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 26 },
      "targets": [{ "refId": "A", "expr": "sum by (status_code) (rate(http_request_duration_seconds_count{job=\"backend\",route=\"/max/webhook\"}[5m]))", "legendFormat": "{{status_code}}" }],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "type": "row", "title": "SLO", "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 34 }
    },
    {
      "type": "stat", "title": "Доступность за 28 дней, цель 99,5%",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 35 },
      "targets": [{ "refId": "A", "expr": "avg(avg_over_time(probe_success{job=\"blackbox\"}[28d]))" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 2,
        "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 0.995 }] }
      } },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat", "title": "Остаток бюджета доступности",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 35 },
      "targets": [{ "refId": "A", "expr": "1 - (1 - avg(avg_over_time(probe_success{job=\"blackbox\"}[28d]))) / 0.005" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 0,
        "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "orange", "value": 0.25 }, { "color": "green", "value": 0.5 }] }
      } },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat", "title": "Брони и погашения без 5xx, цель 99,9%",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 35 },
      "targets": [{ "refId": "A", "expr": "1 - (sum(increase(http_request_duration_seconds_count{job=\"backend\",method=\"POST\",route=~\"/api/v1/bookings|/api/v1/venue/bookings/redeem\",status_code=~\"5..\"}[28d])) or vector(0)) / sum(increase(http_request_duration_seconds_count{job=\"backend\",method=\"POST\",route=~\"/api/v1/bookings|/api/v1/venue/bookings/redeem\"}[28d]))" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 2,
        "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 0.999 }] }
      } },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat", "title": "API быстрее 800 мс, цель 99%",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 35 },
      "targets": [{ "refId": "A", "expr": "sum(increase(http_request_duration_seconds_bucket{job=\"backend\",le=\"0.8\",route!~\"/max/webhook|/api/v1/diary/meals/(photo|text)|/api/v1/venue/menu/imports.*\"}[28d])) / sum(increase(http_request_duration_seconds_count{job=\"backend\",route!~\"/max/webhook|/api/v1/diary/meals/(photo|text)|/api/v1/venue/menu/imports.*\"}[28d]))" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 2,
        "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 0.99 }] }
      } },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "timeseries", "title": "Скорость сгорания бюджета",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 39 },
      "targets": [
        { "refId": "A", "expr": "slo:availability_errors:ratio_rate1h / 0.005", "legendFormat": "доступность, 1 ч" },
        { "refId": "B", "expr": "slo:availability_errors:ratio_rate6h / 0.005", "legendFormat": "доступность, 6 ч" },
        { "refId": "C", "expr": "slo:booking_errors:ratio_rate1h / 0.001", "legendFormat": "брони, 1 ч" },
        { "refId": "D", "expr": "slo:booking_errors:ratio_rate6h / 0.001", "legendFormat": "брони, 6 ч" }
      ],
      "fieldConfig": { "defaults": { "unit": "none", "min": 0,
        "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 6 }, { "color": "red", "value": 14.4 }] },
        "custom": { "thresholdsStyle": { "mode": "line" } }
      } }
    },
    {
      "type": "timeseries", "title": "Доля ответов API медленнее 800 мс",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 39 },
      "targets": [
        { "refId": "A", "expr": "slo:api_slow:ratio_rate5m", "legendFormat": "5 мин" },
        { "refId": "B", "expr": "slo:api_slow:ratio_rate1h", "legendFormat": "1 ч" },
        { "refId": "C", "expr": "slo:api_slow:ratio_rate6h", "legendFormat": "6 ч" }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0 } }
    },
    {
      "type": "row", "title": "Фоновые задачи", "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 47 }
    },
    {
      "type": "timeseries", "title": "Запуски задач за 15 минут",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 48 },
      "targets": [{ "refId": "A", "expr": "sum by (name, result) (increase(ppshkin_job_runs_total[15m]))", "legendFormat": "{{name}} {{result}}" }]
    },
    {
      "type": "timeseries", "title": "С последнего успешного запуска",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 48 },
      "targets": [{ "refId": "A", "expr": "time() - max by (name) (ppshkin_job_last_success_timestamp_seconds)", "legendFormat": "{{name}}" }],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 } }
    },
    {
      "type": "timeseries", "title": "Длительность задач, p95",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 48 },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, name) (rate(ppshkin_job_duration_seconds_bucket[1h])))", "legendFormat": "{{name}}" }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "type": "row", "title": "Сервер", "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 56 }
    },
    {
      "type": "timeseries", "title": "CPU",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 57 },
      "targets": [{ "refId": "A", "expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))", "legendFormat": "занято" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } }
    },
    {
      "type": "timeseries", "title": "Память",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 6, "x": 6, "y": 57 },
      "targets": [{ "refId": "A", "expr": "1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes", "legendFormat": "занято" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } }
    },
    {
      "type": "timeseries", "title": "Диск /",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 6, "x": 12, "y": 57 },
      "targets": [{ "refId": "A", "expr": "1 - node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"}", "legendFormat": "занято" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } }
    },
    {
      "type": "timeseries", "title": "Память backend",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 57 },
      "targets": [
        { "refId": "A", "expr": "process_resident_memory_bytes{job=\"backend\"}", "legendFormat": "RSS" },
        { "refId": "B", "expr": "nodejs_heap_size_used_bytes{job=\"backend\"}", "legendFormat": "heap" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "type": "table", "title": "Сработавшие алерты",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 64 },
      "targets": [{ "refId": "A", "expr": "ALERTS{alertstate=\"firing\"}", "instant": true, "format": "table" }],
      "transformations": [{ "id": "organize", "options": { "excludeByName": { "Time": true, "Value": true, "__name__": true, "alertstate": true } } }]
    }
  ]
}
