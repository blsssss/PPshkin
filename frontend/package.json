{
  "name": "ppshkin-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "api:generate": "npx -y openapi-typescript@7.13.0 ../openapi.yaml -o src/api/schema.d.ts",
    "prelint": "npm run api:generate",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "pretypecheck": "npm run api:generate",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run api:generate",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "@maxhub/max-ui": "0.5.0",
    "@tanstack/react-query": "5.104.0",
    "openapi-fetch": "0.17.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.1",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
